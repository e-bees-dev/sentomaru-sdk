{
  "name": "sentomaru-react-native-app",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal React Native app (new architecture) that compiles the Sentomaru module in CI. Not published; not a product.",
  "scripts": {
    "start": "react-native start",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/react": "^18.2.6",
    "typescript": "5.0.4"
  },
  "engines": { "node": ">=18" },
  "codegenConfig": {
    "name": "SentomaruSpec",
    "type": "modules",
    "jsSrcsDir": "../src",
    "android": { "javaPackageName": "br.com.ebees.sentomaru.reactnative" }
  }
}
