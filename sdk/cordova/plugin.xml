<?xml version="1.0" encoding="UTF-8"?>
<!-- Cordova plugin over the Android SDK. Not published to a public registry; not yet validated inside a Cordova app. -->
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="br.com.ebees.sentomaru.cordova" version="0.0.0">
  <name>Sentomaru</name>
  <description>Sentomaru SDK for Cordova: thin layer over the Android SDK.</description>
  <engines>
    <engine name="cordova-android" version=">=13.0.0" />
  </engines>
  <js-module src="www/bridge.js" name="bridge" />
  <js-module src="www/sentomaru.js" name="Sentomaru">
    <clobbers target="Sentomaru" />
  </js-module>
  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="Sentomaru">
        <param name="android-package" value="br.com.ebees.sentomaru.cordova.SentomaruPlugin" />
      </feature>
    </config-file>
    <!-- Sources: android/src/main/kotlin (this layer) and ../hybrid-core/src/main/kotlin (the shared core). Packaging the shared core into an app
         project is not proven here: see sdk/cordova/README.md. -->
    <source-file src="android/src/main/kotlin/br/com/ebees/sentomaru/cordova/SentomaruPlugin.kt" target-dir="app/src/main/kotlin/br/com/ebees/sentomaru/cordova" />
    <source-file src="android/src/main/kotlin/br/com/ebees/sentomaru/cordova/BridgeValues.kt" target-dir="app/src/main/kotlin/br/com/ebees/sentomaru/cordova" />
  </platform>
</plugin>
