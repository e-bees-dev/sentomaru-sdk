{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentomaru.ebees.com.br/schemas/sdk/signals-catalog-v1.json",
  "title": "SentomaruSignalsCatalogV1",
  "type": "object",
  "required": ["version", "updatedAt", "capabilities"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capabilityId",
          "version",
          "description",
          "source",
          "supportedPlatforms",
          "supportedStates",
          "budgetMs",
          "limitations",
          "fixture"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,32}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["client_observed", "platform_verified", "server_verified", "server_behavioral"]
          },
          "supportedPlatforms": {
            "type": "array",
            "items": { "type": "string", "enum": ["android", "ios"] },
            "minItems": 1,
            "uniqueItems": true
          },
          "minSdk": {
            "description": "Lowest Android API level; required exactly when supportedPlatforms holds android.",
            "type": "integer",
            "minimum": 21
          },
          "minIosVersion": {
            "description": "Catalog 1.7.0: lowest iOS version (MAJOR.MINOR); required exactly when supportedPlatforms holds ios.",
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "supportedStates": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["DETECTED", "NOT_DETECTED", "UNKNOWN", "UNSUPPORTED", "ERROR", "STALE"]
            },
            "minItems": 1
          },
          "budgetMs": {
            "type": "integer",
            "minimum": 1
          },
          "limitations": {
            "type": "string"
          },
          "fixture": {
            "type": "object",
            "required": ["capabilityId", "version", "state", "source"],
            "properties": {
              "capabilityId": { "type": "string" },
              "version": { "type": "string" },
              "state": {
                "type": "string",
                "enum": ["DETECTED", "NOT_DETECTED", "UNKNOWN", "UNSUPPORTED", "ERROR", "STALE"]
              },
              "source": { "type": "string" },
              "detail": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "supportedPlatforms": { "contains": { "const": "android" } } } },
            "then": { "required": ["minSdk"] },
            "else": { "not": { "required": ["minSdk"] } }
          },
          {
            "if": { "properties": { "supportedPlatforms": { "contains": { "const": "ios" } } } },
            "then": { "required": ["minIosVersion"] },
            "else": { "not": { "required": ["minIosVersion"] } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
