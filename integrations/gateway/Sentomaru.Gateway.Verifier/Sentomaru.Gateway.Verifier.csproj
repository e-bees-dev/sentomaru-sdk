       core of Sentomaru.AspNetCore (SentomaruEvaluationPipeline + SentomaruExtractor, no UsePathBase, no MVC), trusted-header or (D-17c2) jwt
       caller. Built and exercised by Integrity.Tests (GatewayVerifierHostTests, GatewayParityTests). Not published (D-17x8). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sentomaru.Gateway.Verifier</RootNamespace>
    <AssemblyName>Sentomaru.Gateway.Verifier</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../aspnetcore/Sentomaru.AspNetCore.csproj" />
  </ItemGroup>
</Project>
